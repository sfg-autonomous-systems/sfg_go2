{
    "name": "Go2",
    "build": {
        "dockerfile": "dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "settings": {
                // General settings.
                "editor.formatOnSave": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.mypy_cache": true
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "args": [
                            "--login"
                        ]
                    }
                },
                "docker.languageserver.formatter.ignoreMultilineInstructions": true,
                "yaml.schemas": {
                    "https://json.schemastore.org/yamllint.json": "*.yaml"
                },
                // Python settings.
                "python.languageServer": "Pylance",
                "python.analysis.extraPaths": [
                    "/opt/ros/${containerEnv:ROS_DISTRO}/local/lib/python3.10/dist-packages",
                    "/opt/ros/${containerEnv:ROS_DISTRO}/lib/python3.10/site-packages",
                    "${containerWorkspaceFolder}/colcon_ws/install/go2/local/lib/python3.10/dist-packages"
                ],
                "debugpy.debugJustMyCode": false,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "mypy-type-checker.args": [
                    "--config-file=${containerWorkspaceFolder}/.mypy.ini"
                ],
                "isort.args": [
                    "--profile",
                    "black"
                ],
                "notebook.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                "notebook.formatOnSave.enabled": true,
                "notebook.lineNumbers": "on"
            },
            "extensions": [
                // General extensions.
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens",
                "GitHub.copilot",
                "redhat.vscode-yaml",
                // Python extensions.
                "njpwerner.autodocstring",
                "ms-python.python",
                "ms-python.isort",
                "ms-python.black-formatter",
                "ms-python.mypy-type-checker",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "runArgs": [
        "--network=host",
        "--runtime=nvidia"
    ]
}
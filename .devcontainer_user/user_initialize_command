#!/usr/bin/env bash

sfg_go2__configure_interface() {
    local connection_type="${1}"
    local connection_name="${2}"
    local interface_name="${3}"
    local args=("${@:4}")

    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/../.devcontainer/scripts/bash_utils/print_utils"

    start_text="> Setting up ${interface_name} ethernet interface for connection to ${connection_name}."
    end_text="< Done setting up ${interface_name} ethernet interface for connection to ${connection_name}."

    sfg_bash_utils__print_info "${start_text}"

    if ! nmcli connection show "${connection_name}" >"/dev/null" 2>&1; then
        sudo nmcli connection add \
            type "${connection_type}" \
            con-name "${connection_name}" \
            ifname "${interface_name}" \
            "${args[@]}"
        sudo nmcli connection up "${connection_name}";
    else
        sfg_bash_utils__print_plain "Connection already exists. Nothing needs to be done."
    fi

    sfg_bash_utils__print_info "${end_text}"
}

sfg_go2__initialize_command() {
    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/../fast_dds_router/.devcontainer/scripts/initialize_command"
    source "${SCRIPT_DIR}/../colcon_ws/src/sfg_lighthouse_tracking/.devcontainer/scripts/install_udev_rules"

    sfg_go2__configure_interface "ethernet" "go2" "enP8p1s0" "ip4" "192.168.123.18/24" "ipv4.method" "manual"
    sfg_go2__configure_interface "ethernet" "lidar" "enxf8e43b9e8820" "ip4" "192.168.1.18/24" "ipv4.method" "manual"
    sfg_fast_dds_router__initialize_command LOCAL_WORKSPACE_DIRECTORY="${SCRIPT_DIR}/../fast_dds_router" CONTAINER_WORKSPACE_DIRECTORY="/workspaces"
    sfg_lighthouse_tracking__install_udev_rules
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_go2__initialize_command "${@}"
fi
